# ============================================
# S.U.G.A.M. 2.0 — Environment Configuration (reference)
# Smart Unified Grievance & Accountability Matrix
# SIH 2026 · PS 26264 · AICTE Complaint Dashboard
# Copy to .env and adjust. Never commit .env to Git.
# The shipped .env already works for local demo — this file
# documents every option and the production migration paths.
# ============================================

# ---------- Runtime ----------
NODE_ENV=development
# true  = demo reset endpoint enabled (SIH demo). Set to false to harden.
DEMO_MODE=true

# ---------- Database ----------
# Local demo (default): SQLite with a path RELATIVE to prisma/schema.prisma,
# so it works on any machine without edits.
DATABASE_URL=file:../db/custom.db

# Production option A — MongoDB (per SUGAM 2.0 §3.1): swap Prisma for Mongoose
#   MONGODB_URI=mongodb://127.0.0.1:27017/sugam
#   MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster/sugam?retryWrites=true
# Production option B — PostgreSQL:
#   1) In prisma/schema.prisma set  provider = "postgresql"
#   2) DATABASE_URL=postgresql://sugam_user:YOUR_PASSWORD@localhost:5432/sugam?schema=public
#   3) npx prisma generate && npx prisma db push

# ---------- Auth ----------
# Sessions are HMAC-signed HttpOnly cookies; passwords hashed with scrypt.
# Generate a strong secret:  openssl rand -hex 32
AUTH_SECRET=replace-with-long-random-local-secret
ACCESS_TOKEN_TTL=7d

# ---------- Evidence / private file storage (Pipeline F) ----------
UPLOAD_MAX_BYTES=10485760
# Files are stored OUTSIDE public web folders; access requires an authenticated,
# case-authorized request. Production must add malware scanning + object storage.
UPLOAD_STORAGE_DIR=./private-uploads

# ---------- Future integrations (P2 — placeholders, add your own keys) ----------
# AI classification / rule assistant (free tier): https://aistudio.google.com
# GEMINI_API_KEY=
# Outbound alerts — WhatsApp Business Cloud API (sandbox for demo):
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=
# Outbound alerts — email (Gmail app password or resend.com free tier):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=your@gmail.com
# SMTP_PASS=your-app-password
# Voice in Indian languages (Govt of India): https://bhashini.gov.in
# BHASHINI_API_KEY=
# Redis + BullMQ for background schedulers (Phase 2):
# REDIS_URL=redis://127.0.0.1:6379
